# Supabase authentication and server-side data access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Temporary fallback only when publishable is unset (legacy JWT anon key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-legacy-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# OpenAI server integration
OPENAI_API_KEY=
OPENAI_POCKET_SUPPORT_MODEL=
OPENAI_POCKET_RESCUE_MODEL=
OPENAI_POCKET_REVIEW_MODEL=
OPENAI_POCKET_FOLLOW_UP_MODEL=
# Emergency owner switch. Set false/off/disabled to stop all paid Pocket AI calls.
POCKET_AI_ENABLED=true
# Fresh full-analysis requests per anonymous device each UTC month. Set 0 for no per-device ceiling.
POCKET_AI_MONTHLY_LIMIT=30
# Optional service-wide UTC-month ceiling. Set 0 to disable this ceiling.
POCKET_AI_GLOBAL_MONTHLY_LIMIT=0
# Strict by default: a database guard outage blocks new paid analysis requests.
POCKET_AI_ALLOWANCE_FAIL_OPEN=false
POCKET_BUDGET_SALT=replace-with-a-long-random-server-only-value
OPENAI_BRIEF_MODEL=
OPENAI_MORNING_BRIEF_MODEL=
OPENAI_SECOND_OPINION_MODEL=gpt-5-mini
# Private owner pilot only. Leave blank to keep AI screenshot interpretation disabled.
SECOND_OPINION_PRIVATE_PILOT=

# Stripe billing and membership synchronization
STRIPE_SECRET_KEY=replace-with-server-only-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-server-only-webhook-signing-secret
STRIPE_PRO_PRICE_ID=price_replace_with_pro_price
STRIPE_FOUNDING_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=price_replace_with_elite_price
STRIPE_PRO_ANNUAL_PRICE_ID=price_replace_with_pro_annual_price
STRIPE_ELITE_ANNUAL_PRICE_ID=price_replace_with_elite_annual_price
NEXT_PUBLIC_STRIPE_PRO_CHECKOUT_URL=
NEXT_PUBLIC_STRIPE_ELITE_CHECKOUT_URL=
STRIPE_CUSTOMER_PORTAL_LINK=https://billing.stripe.com/p/login/replace-with-portal-link
BULLSEYE_ADMIN_EMAILS=

# Optional launch email dispatch integration.
# Leave blank to keep dispatch disabled. Resend transport is dormant until all three are configured.
LAUNCH_EMAIL_PROVIDER=
LAUNCH_EMAIL_FROM=
RESEND_API_KEY=

# Optional free official macro APIs (server only)
# Keys are free from the relevant U.S. government agency; feeds fail closed when absent.
BEA_API_KEY=
CENSUS_API_KEY=

# Financial Modeling Prep market provider
MARKET_DATA_PROVIDER=fmp
FMP_API_KEY=replace-with-server-only-provider-key
# Optional override; the application defaults to https://financialmodelingprep.com/stable/
FMP_API_BASE_URL=https://financialmodelingprep.com/stable

# Optional market-provider controls
FMP_REQUEST_TIMEOUT_MS=5000
MARKET_DATA_MAX_RETRIES=1
MARKET_DATA_RETRY_DELAY_MS=250
# FMP_SP500_FUTURES_SYMBOL=ESUSD
# FMP_VIX_SYMBOL=^VIX
# FMP_US_DOLLAR_INDEX_SYMBOL=DX-Y.NYB # FMP Stable index catalogue identifier

# Alternative normalized HTTP provider (use instead of FMP)
# MARKET_DATA_API_URL=https://provider.example/normalized-snapshot
# MARKET_DATA_API_TOKEN=replace-with-server-only-bearer-token
# MARKET_DATA_PROVIDER_NAME=replace-with-provider-display-name

# Safe build diagnostics (set by the deployment pipeline)
APP_VERSION=1.0.0-rc.2
BUILD_TIMESTAMP=2026-07-17T00:00:00.000Z
GIT_COMMIT_SHA=replace-with-deployed-commit-sha
BULLSEYE_TEST_TOTALS=

# Playwright Project Bullseye audit (dedicated test account only — never commit real values)
AUDIT_BASE_URL=https://nash-ai-markets-git-feature-morning-brie-3c2717-nash-ai-markets.vercel.app
AUDIT_USER_EMAIL=
AUDIT_USER_PASSWORD=
