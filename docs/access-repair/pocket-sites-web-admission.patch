diff --git a/app/api/pocket/subscription-access/route.ts b/app/api/pocket/subscription-access/route.ts
new file mode 100644
index 0000000..5879591
--- /dev/null
+++ b/app/api/pocket/subscription-access/route.ts
@@ -0,0 +1,12 @@
+import { requirePocketWebScanAccess } from "../../../lib/server/pocket-web-scan-access";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+
+/** Own server-verified account only; no payment, write or provider request. */
+export async function GET() {
+  const denial = await requirePocketWebScanAccess();
+  const headers = { "Cache-Control": "private, no-store", Vary: "Cookie" };
+  if (denial) return Response.json({ ...await denial.json(), entitled: false }, { status: denial.status, headers });
+  return Response.json({ entitled: true }, { headers });
+}
diff --git a/app/lib/server/pocket-web-scan-access.ts b/app/lib/server/pocket-web-scan-access.ts
new file mode 100644
index 0000000..4d328e3
--- /dev/null
+++ b/app/lib/server/pocket-web-scan-access.ts
@@ -0,0 +1,47 @@
+type Identity = { id?: string; email?: string; email_confirmed_at?: string; is_anonymous?: boolean };
+type AccessDependencies = {
+  authenticate: () => Promise<Identity | null>;
+  hasSubscription: (userId: string) => Promise<boolean>;
+  hasAppleSubscription?: (userId: string) => Promise<boolean>;
+  hasFirstFreeAccess?: (user: Identity) => Promise<boolean>;
+};
+
+/** A verified identity and current Pocket subscription are both required.
+ * Founding awards, terminal tiers and client/local-storage assertions grant no access. */
+export async function checkPocketScanAccess(deps: AccessDependencies): Promise<Response | null> {
+  try {
+    const user = await deps.authenticate();
+    if (!user?.id || !user.email || !user.email_confirmed_at || user.is_anonymous) return Response.json({ error: "Sign in with your verified Pocket account to scan.", code: "POCKET_LOGIN_REQUIRED" }, { status: 401 });
+    let webUnavailable = false;
+    try { if (await deps.hasSubscription(user.id)) return null; }
+    catch { webUnavailable = true; }
+    if (user.id && deps.hasAppleSubscription && await deps.hasAppleSubscription(user.id)) return null;
+    // Independent signed Apple proof can succeed during a web-ledger outage.
+    // A web outage must never become first-free permission or a false expiry.
+    if (webUnavailable) throw new Error("Pocket web subscription lookup unavailable");
+    if (user.id && deps.hasFirstFreeAccess && await deps.hasFirstFreeAccess(user)) return null;
+    return Response.json({ error: "An active Pocket subscription is required to scan.", code: "POCKET_SUBSCRIPTION_REQUIRED" }, { status: 403 });
+  } catch {
+    return Response.json({ error: "Pocket access could not be verified. Please retry shortly.", code: "POCKET_ACCESS_UNAVAILABLE" }, { status: 503 });
+  }
+}
+
+/** Pocket Sites web admission; native uses its separately pinned production backend. */
+export async function requirePocketWebScanAccess(): Promise<Response | null> {
+  if (process.env.POCKET_WEB_SCANS_DISABLED === "true") {
+    return Response.json({ error: "Pocket access is temporarily unavailable.", code: "POCKET_ACCESS_UNAVAILABLE" }, { status: 503 });
+  }
+  return checkPocketScanAccess({
+    authenticate: async () => {
+      const { createClient } = await import("../../../utils/supabase/server.ts");
+      const { data: { user }, error } = await (await createClient()).auth.getUser();
+      return error ? null : user;
+    },
+    hasSubscription: async (userId) => {
+      const { createAdminClient } = await import("../../../utils/supabase/admin.ts");
+      const { data, error } = await createAdminClient().rpc("has_pocket_web_subscription", { p_user_id: userId });
+      if (error || typeof data !== "boolean") throw new Error("Pocket subscription lookup unavailable");
+      return data;
+    },
+  });
+}
diff --git a/tests/pocket-web-worker-access.test.mjs b/tests/pocket-web-worker-access.test.mjs
new file mode 100644
index 0000000..a1ab65f
--- /dev/null
+++ b/tests/pocket-web-worker-access.test.mjs
@@ -0,0 +1,61 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+// Runs the real packaged Worker with a closed, offline Supabase fixture.
+// Every unrecognised outbound request fails; no OpenAI or Apple call can occur.
+test('packaged Pocket web guard verifies response cookies, UUID-bound access and denials before all scanner dispatches', async () => {
+  process.env.NEXT_PUBLIC_SUPABASE_URL = 'https://fixture.supabase.co';
+  process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_fixture';
+  process.env.SUPABASE_SERVICE_ROLE_KEY = 'offline-service-role';
+  const user = { id: '11111111-1111-4111-8111-111111111111', email: 'qa@example.invalid', email_confirmed_at: '2026-10-19T00:00:00Z', aud: 'authenticated', role: 'authenticated', is_anonymous: false, app_metadata: {}, user_metadata: {}, identities: [], created_at: '2026-10-19T00:00:00Z' };
+  const token = [Buffer.from('{"alg":"HS256"}').toString('base64url'), Buffer.from(JSON.stringify({sub:user.id, exp:Math.floor(Date.now()/1000)+3600})).toString('base64url'), 'offline-fixture'].join('.');
+  let entitled = true;
+  let outage = false;
+  let unexpected = 0;
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = async (input, init) => {
+    const url = typeof input === 'string' ? input : input.url;
+    if (url === 'https://fixture.supabase.co/auth/v1/user') return Response.json(user);
+    if (url === 'https://fixture.supabase.co/rest/v1/rpc/has_pocket_web_subscription') {
+      assert.deepEqual(JSON.parse(init.body), { p_user_id: user.id });
+      return outage ? Response.json({ message: 'offline outage' }, { status: 503 }) : Response.json(entitled);
+    }
+    unexpected += 1;
+    throw new Error('Unexpected outbound request in offline test');
+  };
+  try {
+    const worker = (await import('../dist/server/index.js')).default;
+    const env = {};
+    const ctx = { waitUntil: () => {} };
+    const request = (path, init = {}) => worker.fetch(new Request('https://pocket.nashaimarkets.com' + path, init), env, ctx);
+    const session = await request('/api/auth/session', { method:'POST', headers:{origin:'https://pocket.nashaimarkets.com','content-type':'application/json'}, body:JSON.stringify({accessToken:token,refreshToken:'offline-fixture-refresh'}) });
+    assert.equal(session.status, 200);
+    const cookieHeaders = session.headers.getSetCookie();
+    assert.ok(cookieHeaders.length > 0);
+    const cookie = cookieHeaders.map(header => header.split(';')[0]).join('; ');
+    const account = await request('/api/pocket/account', { headers:{cookie} });
+    assert.equal(account.status, 200);
+    assert.deepEqual(await account.json(), {user_id:user.id, verified:true});
+    const access = await request('/api/pocket/subscription-access?user_id=attacker', {headers:{cookie}});
+    assert.equal(access.status, 200);
+    assert.deepEqual(await access.json(), {entitled:true});
+    assert.equal(access.headers.get('cache-control'), 'private, no-store');
+    assert.match(access.headers.get('vary'), /(?:^|,\s*)Cookie(?:,|$)/);
+    entitled = false;
+    const denied = await request('/api/pocket/subscription-access', {headers:{cookie}});
+    assert.equal(denied.status, 403);
+    for (const route of ['analyse','preflight','levels','liquidity','options-wall','crypto-pressure','review','follow-up']) {
+      const response = await request('/api/pocket/' + route, {method:'POST',headers:{cookie,'content-type':'application/json'},body:JSON.stringify({user_id:'attacker',entitled:true})});
+      assert.equal(response.status, 403, route);
+    }
+    outage = true;
+    assert.equal((await request('/api/pocket/subscription-access',{headers:{cookie}})).status,503);
+    assert.equal((await request('/api/pocket/subscription-access')).status,401);
+    process.env.POCKET_WEB_SCANS_DISABLED = 'true';
+    assert.equal((await request('/api/pocket/subscription-access',{headers:{cookie}})).status,503);
+    delete process.env.POCKET_WEB_SCANS_DISABLED;
+    assert.equal(unexpected, 0);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
