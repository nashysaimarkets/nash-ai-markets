{
  "name": "nash-ai-markets-bullseye",
  "version": "1.0.0-rc.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:render && npm run build && npm run test:rendered",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:render": "node --import tsx --test tests/render/*.test.ts tests/render/*.test.tsx",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "simulate:production": "node --test tests/production-launch-simulation.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "ops:validate": "bash scripts/validate-operations-docs.sh",
    "ops:check-env": "bash scripts/check-production-env.sh",
    "verify:brief": "node --env-file-if-exists=.env --import tsx scripts/verify-brief.tsx",
    "verify:pocket-goldens": "node --env-file-if-exists=.env --import tsx scripts/run-pocket-golden-regressions.ts",
    "verify:pocket-goldens:release": "POCKET_GOLDEN_RELEASE_GATE=1 node --env-file-if-exists=.env --import tsx scripts/run-pocket-golden-regressions.ts",
    "verify:offline-extractor": "node --import tsx --test tests/offline-chart-extractor.test.ts",
    "verify:offline-ig": "node --import tsx prototype/chart-extraction/benchmark-ig.ts",
    "verify:customer-engine": "node --import tsx prototype/chart-extraction/benchmark-customer-engine.ts",
    "verify:customer-cross-platform": "node --import tsx prototype/chart-extraction/benchmark-customer-cross-platform.ts",
    "diagnose:providers": "node --env-file-if-exists=.env --import tsx scripts/diagnose-providers.ts",
    "security:scan": "node scripts/check-secrets.mjs",
    "repair:native": "node scripts/repair-native-bindings.mjs",
    "audit:deadcode": "node scripts/dead-code-report.mjs --json",
    "audit:layout": "node scripts/layout-check.mjs",
    "preview:member": "node --import tsx scripts/preview-member-surfaces.tsx",
    "preview:shots": "npm run preview:member && node scripts/preview-screenshots.mjs",
    "visual-review": "node --env-file-if-exists=.env --import tsx scripts/visual-review.ts",
    "staging:export-storage": "node --env-file-if-exists=.env --import tsx scripts/export-storage-state.ts",
    "staging:auth-evidence": "node --env-file-if-exists=.env --import tsx scripts/staging-auth-evidence.ts",
    "audit:typefloor": "node scripts/apply-type-floor.mjs",
    "audit:motion": "node scripts/apply-motion-tokens.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "audit:setup": "node --experimental-strip-types audit/src/run-audit.ts --mode=setup",
    "audit:public": "node --experimental-strip-types audit/src/run-audit.ts --mode=public",
    "audit:desktop": "node --experimental-strip-types audit/src/run-audit.ts --mode=desktop",
    "audit:mobile": "node --experimental-strip-types audit/src/run-audit.ts --mode=mobile",
    "audit:all": "node --experimental-strip-types audit/src/run-audit.ts --mode=all",
    "audit:report": "node --experimental-strip-types audit/src/run-audit.ts --mode=all"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "^5.2.0",
    "next": "16.2.12",
    "openai": "6.48.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "ws": "8.21.1",
    "sharp": "0.35.0"
  },
  "type": "module",
  "displayName": "NASH AI Markets — Project Bullseye"
}
