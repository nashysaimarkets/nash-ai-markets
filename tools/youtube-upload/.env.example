# Operator-only YouTube upload OAuth (Project BULLSEYE video automation).
# NEVER commit real values. Copy to tools/youtube-upload/.env.local (gitignored).
# Completely separate from customer Supabase / magic-link / Stripe auth.

# From Google Cloud Console → Clients → NASH AI Markets Uploader
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an authorized redirect URI on the OAuth web client.
# Local CLI / callback scaffold defaults:
YOUTUBE_REDIRECT_URI=http://localhost:8787/api/youtube/oauth/callback

# Production (when operator callback is deployed):
# YOUTUBE_REDIRECT_URI=https://www.nashaimarkets.com/api/youtube/oauth/callback

# Optional: path to store refresh token after first consent (gitignored).
# YOUTUBE_TOKEN_PATH=./.tokens/youtube-oauth.json

# ONLY scope used by this tool:
# https://www.googleapis.com/auth/youtube.upload
